{
  "name": "in-terminal",
  "displayName": "Open Terminal Programmatically",
  "description": "Programmatically open your terminal 🚀",
  "icon": "assets/logo-big.png",
  "version": "0.1.1",
  "license": "MIT",
  "main": "dist/extension.js",
  "publisher": "open",
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "node --test",
    "tsc": "tsc -p tsconfig.json",
    "build": "webpack --mode development",
    "build:watch": "webpack --mode development --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {},
    "commands": [
      {
        "command": "in-terminal.restart",
        "title": "Open Terminal: Restart"
      },
      {
        "command": "in-terminal.open",
        "title": "Open Terminal: Open"
      }
    ],
    "menus": {
      "commandPalette": []
    }
  },
  "bugs": {
    "url": "https://github.com/talkohavy/open-terminal-vscode-extension/issues"
  },
  "author": {
    "name": "Tal Kohavy",
    "email": "talkohavy@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/talkohavy/open-terminal-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "keywords": ["vscode", "vsc", "extension", "terminal"],
  "categories": ["Other"],
  "dependencies": {
    "@types/vscode": "^1.120.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
